#!/usr/bin/env bash
set -Eeuo pipefail
# Git wrapper to be called by Idea to get the environment to have
# * ssh key working (ssh agent)
# * all git hook working such as `commitlint`
#
# By default, Idea call git with the wsl cli from windows (ie Intellij)
# ie wsl git
#
# In settings, you can change that
#

if [ -d "$HOME/.profile.d" ]; then
  # All file loaded in a directory should have a sh extension
  # This is how /etc/profile also work
  for file in "$HOME"/.profile.d/*.sh; do
    # shellcheck disable=SC1090
    [ -r "$file" ] && source "$file"
  done
  unset file
fi


# Get the original
# We take the next path in the list of (which -a script_basename)
# And not (which -a cmd | sed -n '2p') as it  may recurse if the file is now the second one
# Note we could also do: (which -a cmd | tail -n 1)
script_path="$(realpath "${BASH_SOURCE[0]}")"
script_basename="$(basename "${BASH_SOURCE[0]}")"
next_self() {
  local found=0 p
  while IFS= read -r p; do
    if (( found )); then
      printf '%s\n' "$p"
      return 0
    fi
    [[ "$(realpath "$p")" == "$script_path" ]] && found=1
  done < <(which -a "$script_basename")
  return 1
}
real_path="$(next_self)" || { echo "$script_basename: no next $script_basename found in PATH" >&2; exit 1; }

# Run
"$real_path" "$@"
