sourceDir: {{ .chezmoi.homeDir }}/code/dotfiles

{{ if eq .chezmoi.hostname "MELISSA01" }}
# Melissa 01
interpreters:
  sh:
    # this is WSL, it start bash in WSL,
    # bash here is C:\Windows\system32\bash.exe
    command: "bash"
{{ end }}

{{ if eq .chezmoi.os "windows" }}
edit:
    command: "C:\\Notepad++\\notepad++.exe"
    args: [ "-multiInst", "-notabbar", "-nosession", "-noPlugin"]
{{ end }}


hooks:
  # https://www.chezmoi.io/user-guide/advanced/install-your-password-manager-on-init/
  # read-source-state:
  #  pre:
  #    command: "{{ .chezmoi.homeDir }}/.install-password-manager.sh"

  # after apply
  apply:
    post:
      command: "{{ .chezmoi.homeDir }}/scripts/chezmoi-install-local"
