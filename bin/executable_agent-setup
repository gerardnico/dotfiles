#!/usr/bin/env bash
# Local setup for project agent
set -Eeuo pipefail


create_symlink() {
  local SOURCE="$1"
  local TARGET="$2"


  if [[ ! -f "$SOURCE" ]]; then
    echo "Source file not found: $SOURCE"
    return
  fi

  if [[ -L "$TARGET" ]]; then
    echo "Symlink found: $TARGET -> $(readlink "$TARGET")"
    return
  fi

  if [[ -f "$TARGET" ]]; then
    echo "A regular file already exists at $TARGET — refusing to overwrite."
    return
  fi

  # We create a symlink otherwise we don't see it in the /context command
  ln -s "$SOURCE" "$TARGET"
  echo "Link created: $SOURCE -> $TARGET"

}

if [[ ! -d "./.claude" ]]; then
  mkdir -p "./.claude"
fi

if [ "${PROJECT_DIR}" == "" ]; then
  echo "Not a project directory. Exiting"
  exit 0
fi

# Claude
SOURCE="$HOME/.claude/settings.local.json"
TARGET="$PROJECT_DIR/.claude/settings.local.json"
create_symlink "$SOURCE" "$TARGET"

# Claude
# Project Instruction file
SOURCE="$PROJECT_DIR/AGENT.md"
TARGET="$PROJECT_DIR/CLAUDE.md"
create_symlink "$SOURCE" "$TARGET"
create_symlink "$PROJECT_DIR/.agent/AGENT.md" "$TARGET"
