#!/usr/bin/env bash
set -Eeuo pipefail

export TMPDIR="/tmp/paseo"
mkdir -p TMPDIR
export AITM_SANDBOXING_WRITABLE_PATHS="$TMPDIR"

# Proxy
export HTTP_PROXY=http://localhost:8080
export HTTPS_PROXY=http://localhost:8080
export http_proxy=http://localhost:8080
export https_proxy=http://localhost:8080
export NODE_EXTRA_CA_CERTS=/home/admin/.mitmproxy/mitmproxy-ca-cert.pem
export NODE_USE_ENV_PROXY=1
export NO_PROXY=localhost,127.0.0.1,.svc,.cluster.local,.localhost
export REQUESTS_CA_BUNDLE=/home/admin/.mitmproxy/mitmproxy-ca-cert.pem
export SSL_CERT_FILE=/home/admin/.mitmproxy/mitmproxy-ca-cert.pem
export CURL_CA_BUNDLE=/home/admin/.mitmproxy/mitmproxy-ca-cert.pem

# Get the original
# We take the next path in the list of (which -a script_basename)
# And not (which -a cmd | sed -n '2p') as it  may recurse if the file is now the second one
# Note we could also do: (which -a cmd | tail -n 1)
script_path="$(realpath "${BASH_SOURCE[0]}")"
script_basename="$(basename "${BASH_SOURCE[0]}")"
next_self() {
  local found=0 p
  while IFS= read -r p; do
    if (( found )); then
      printf '%s\n' "$p"
      return 0
    fi
    [[ "$(realpath "$p")" == "$script_path" ]] && found=1
  done < <(which -a "$script_basename")
  return 1
}
real_path="$(next_self)" || { echo "$script_basename: no next $script_basename found in PATH" >&2; exit 1; }

"$real_path" "$@"
