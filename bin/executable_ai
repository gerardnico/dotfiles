#!/usr/bin/env bash
set -Eeuo pipefail

# Aitm Wrapper script to inject env

# "$(which -a git | sed -n '2p')" "$@"
AITM_PATH=${AITM_PATH:-"$HOME/code/gerardnico/aitm/.venv/bin/aitm"}
if ! [ -f "$AITM_PATH" ]; then
  echo "Aitm not found at $AITM_PATH."
  echo "Possible Solutions: Claude is not installed"
  echo "Possible Solutions: Set the AITM_PATH env to another path"
  exit 1
fi

export OPENROUTER_API_KEY
OPENROUTER_API_KEY=$(pass "gerardnico/openrouter/api-key")

# Free
export AITM_AGENT_DEFAULT_MODEL="stealth/space-bunny-alpha"

"$AITM_PATH" "$@"
